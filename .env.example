# Copy this file to .env and fill in what you need.
# All variables are optional — the scanner works without any of them.

# GitHub personal access token (repo scope) — required only for private repos
GITHUB_TOKEN=

# NVD API key — speeds up the OWASP Dependency-Check DB download on first Java scan
# Free key: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# API key to protect the /scan endpoint — leave empty for open (dev) access
SCANNER_API_KEY=
