  package "Public API" #EEF4FF {
    [scanner.py\nPromptScanner] as SCANNER
    [cli.py\nCLI Interface] as CLI
    [__init__.py\nPublic Exports] as INIT
  }

  package "Configuration" #FFF9C4 {
    [config.py\nScanConfig\nDEFAULT_CONFIG] as CONFIG
  }

  package "Analyzers" #E8F5E9 {
    [static_analyzer.py\nStaticAnalyzer] as STATIC
    [heuristic_analyzer.py\nHeuristicAnalyzer] as HEURISTIC
    [semantic_analyzer.py\nSemanticAnalyzer] as SEMANTIC
  }

  package "Rules Engine" #FFF3E0 {
    [injection_rules.py] as INJECT
    [jailbreak_rules.py] as JAILBREAK
    [exfiltration_rules.py] as EXFIL
    [roleplay_rules.py] as ROLEPLAY
  }

  package "Utilities" #F3E5F5 {
    [encoding_detector.py\ndecode_and_check\nhas_suspicious_encoding] as ENCDET
    [text_utils.py\nnormalize_text] as TXTUTIL
  }

  package "Scoring & Findings" #FCE4EC {
    [scoring.py\ncalculate_risk_score\ndetermine_risk_level\ngenerate_recommendations] as SCORING
    [findings.py\nFinding · ScanResult\nFindingType · Severity] as FINDINGS
  }

  package "Optional Integrations" #ECEFF1 {
    [garak_adapter.py\nGarakAdapter] as GARAK
    [nemo_adapter.py\nNemoAdapter] as NEMO
    [guardrails_adapter.py\nGuardrailsAdapter] as GUARDRAILS
  }

}

' External actors
[Backend API\n(main.py)] as BACKENDAPI #LightSteelBlue
[LLM Service] as LLM #palegreen

' Public entry points
BACKENDAPI --> INIT : "import scan_prompt()"
CLI --> SCANNER : "scan(prompt)"
INIT --> SCANNER

' Scanner orchestration
SCANNER --> CONFIG : reads
SCANNER --> STATIC : analyze(text)
SCANNER --> HEURISTIC : analyze(text)
SCANNER --> SEMANTIC : analyze(text)
SCANNER --> ENCDET : pre-process
SCANNER --> TXTUTIL : normalize
SCANNER --> SCORING : calculate_risk_score(findings)
SCANNER --> FINDINGS : build ScanResult
SCANNER --> GARAK : "optional scan()"
SCANNER --> NEMO : "optional scan()"
SCANNER --> GUARDRAILS : "optional scan()"

' Rules wired into analyzers
STATIC --> INJECT : loads rules
STATIC --> JAILBREAK : loads rules
STATIC --> EXFIL : loads rules
STATIC --> ROLEPLAY : loads rules
HEURISTIC --> INJECT : references
HEURISTIC --> JAILBREAK : references

' Scoring uses findings types
SCORING --> FINDINGS : "uses FindingType\n& Severity weights"

' Result flow
SCANNER --> BACKENDAPI : "ScanResult"
BACKENDAPI --> LLM : "only if safe == True"

