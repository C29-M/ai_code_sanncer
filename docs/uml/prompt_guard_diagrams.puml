title <b>High-Level System Architecture</b>\nAI Code Scanner + Prompt Guard Integration

actor "Developer / User" as User #LightSteelBlue

rectangle "Frontend\n(Static Web UI)" as UI
rectangle "Backend API\n(FastAPI — main.py)" as API
rectangle "Repo Scanner\nPipeline" as RepoScanner {
  rectangle "10 Parallel Scanners\n(Semgrep · Bandit · ESLint · Gitleaks\nGoSec · Trivy · TruffleHog · Safety\nOWASP DepCheck · SpotBugs)" as Scanners
  rectangle "Normalizer\n(normalizer.py)" as Normalizer
}

rectangle "Prompt Guard\n(prompt_guard package)" as PG #E3F2FD {
  rectangle "PromptScanner\n(scanner.py)" as Scanner
  rectangle "Analysis Engine" as AnalysisEngine {
    rectangle "Static Analyzer" as SA
    rectangle "Heuristic Analyzer" as HA
    rectangle "Semantic Analyzer" as SeA
    rectangle "Encoding Detector" as ED
  }
  rectangle "Risk Scoring Engine\n(scoring.py)" as Scoring
}

cloud "LLM Service\n(External / Self-hosted)" as LLM
database "Findings DB\n& Reporting Layer" as DB

User --> UI : "Submit scan request\nor prompt query"
UI --> API : "HTTP POST /scan\nor /prompt/analyze"
API --> RepoScanner : "Clone & scan\nrepository"
API --> PG : "Intercept prompt\nbefore LLM call"
RepoScanner --> Normalizer : raw findings
Normalizer --> DB : normalised findings
PG --> Scanner
Scanner --> AnalysisEngine
AnalysisEngine --> Scoring : findings list
Scoring --> API : "ScanResult\n(safe | risk_score | findings)"
API --> LLM : "Forward ONLY if safe == True"
LLM --> API : LLM response
API --> DB : audit log
API --> UI : JSON response
DB --> UI : historical reports

note right of PG
  <b>Intercept Point</b>
  Prompt Guard sits between
  the API and the LLM.
  Unsafe prompts are blocked
  before any LLM call is made.
end note

note bottom of RepoScanner
  Existing pipeline — unchanged.
  Prompt Guard is an additive layer.
end note

@enduml


' ─────────────────────────────────────────────────────────────
' DIAGRAM 2 — Prompt Scanning Workflow (Activity / Sequence)
' ─────────────────────────────────────────────────────────────

@startuml 02_prompt_scanning_workflow
!theme plain
skinparam backgroundColor #FAFAFA
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 13
skinparam shadowing false
skinparam ArrowColor #4A6FA5
skinparam ActivityBorderColor #4A6FA5
skinparam ActivityBackgroundColor #EEF4FF
skinparam ActivityDiamondBackgroundColor #FFF9C4
skinparam ActivityDiamondBorderColor #F9A825
skinparam NoteBackgroundColor #E8F5E9
skinparam NoteBorderColor #388E3C

title <b>Prompt Scanning Workflow</b>\nRuntime Prompt Security Analysis Pipeline

start

:User submits a prompt;
note right: Any natural-language input\ntargeted at the LLM

:API receives request\n(POST /prompt/analyze);

:Instantiate **PromptScanner**\nwith ScanConfig;

partition "**Text Pre-processing**" {
  :Normalize text\n(normalize_text());
  :Check for suspicious encoding\n(has_suspicious_encoding());
  if (Suspicious encoding detected?) then (yes)
    :Decode and add decoded\nvariant to scan queue;
    note right: Catches Base64,\nURL-encoded, Unicode\nobfuscation attacks
  else (no)
  endif
}

partition "**Analysis Pipeline**  (parallel passes)" {
  fork
    :Static Analyzer\n──────────────\nPattern matching\ninjection_rules\njailbreak_rules\nexfiltration_rules\nroleplay_rules;
  fork again
    :Heuristic Analyzer\n──────────────\nBehavioral signals\nInstruction override\nPatterns & n-grams;
  fork again
    :Semantic Analyzer\n──────────────\nContextual intent\nMeaning-level checks\nInstruction semantics;
  end fork

  :Merge all findings;
  :Deduplicate findings\n(_deduplicate_findings());
}

partition "**Risk Scoring**" {
  :Calculate risk score\n(calculate_risk_score());
  note right: Weighted sum across\nfinding types & severities\nScore range: 0.0 – 100.0
  :Determine risk level\n(LOW | MEDIUM | HIGH | CRITICAL);
  :Generate summary &\nrecommendations;
}

if (risk_score < risk_threshold\n**safe == True**?) then (Safe)
  #palegreen:Forward prompt to LLM;
  :Receive LLM response;
  :Return response to user\n(HTTP 200 + ScanResult metadata);
else (Risky)
  #tomato:Block request — do NOT call LLM;
  :Return structured findings\nto caller (HTTP 200, safe=false);
  note right
    Response includes:
    • risk_score
    • risk_level
    • findings[] with severity
    • recommendations[]
  end note
  :Audit log written to DB;
endif

:End;
stop

@enduml


